# Copy thanh .env roi dien gia tri that. File .env KHONG duoc commit.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/courtly
DB_USERNAME=courtly
DB_PASSWORD=doi-mat-khau-nay

# --- Bao mat ---
# Toi thieu 32 ky tu cho HS256. Sinh bang: openssl rand -hex 32
JWT_SECRET=doi-truoc-khi-len-moi-truong-that
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Gui mail ---
# DigitalOcean chan cong SMTP 25/465/587. Dung Brevo relay cong 2525 de di vong.
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=dang-nhap-smtp-cua-ban
MAIL_PASSWORD=khoa-smtp-cua-ban
# Bat buoc la sender da xac minh trong Brevo, neu khong se bi tu choi.
MAIL_FROM_ADDRESS=noreply@ten-mien-cua-ban
MAIL_FROM_NAME=Courtly

# --- Thanh toan SePay (2.1.33 - 2.1.42) ---
# SEPAY_API_KEY do ban tu dat, phai trung voi o API Key khi tao webhook ben SePay.
# De trong thi moi webhook deu bi tu choi va don se khong tu xac nhan duoc.
SEPAY_API_KEY=
# So tai khoan phai TRUNG voi tai khoan da ket noi trong SePay,
# neu khong thi tien vao mot tai khoan SePay khong nhin thay va webhook khong chay.
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_NAME=MB Bank
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=Courtly

# --- Du lieu mau ---
# true = nap du lieu mau luc khoi dong. Profile prod luon tat du dat true.
SEED_ENABLED=false
